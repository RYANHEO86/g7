{
  "meta": {
    "is_partial": true,
    "description": "테마 게시판(slug='theme') 전용 extra_data 입력 섹션. 가격/라이센스/스펙 등 단순 필드는 개별 input, 갤러리/features/changelog 등 배열·중첩 데이터는 JSON textarea (하이브리드)."
  },
  "id": "theme_extra_fields_card",
  "type": "basic",
  "name": "Div",
  "if": "{{form_meta?.data?.board?.slug == 'theme'}}",
  "props": {
    "className": "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 space-y-6"
  },
  "children": [
    {
      "type": "basic",
      "name": "Div",
      "props": { "className": "flex items-center justify-between" },
      "children": [
        {
          "type": "basic",
          "name": "H3",
          "props": { "className": "text-base font-semibold text-gray-900 dark:text-white" },
          "children": ["테마 카탈로그 추가 정보"]
        },
        {
          "type": "basic",
          "name": "Span",
          "props": { "className": "text-xs text-gray-500 dark:text-gray-400" },
          "children": ["theme 게시판 전용 필드 — extra_data 컬럼에 저장됨"]
        }
      ]
    },

    {
      "type": "basic",
      "name": "Div",
      "props": { "className": "grid grid-cols-1 md:grid-cols-2 gap-4" },
      "children": [
        {
          "type": "basic",
          "name": "Div",
          "children": [
            {
              "type": "basic",
              "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["가격 (원)"]
            },
            {
              "type": "basic",
              "name": "Input",
              "props": {
                "type": "number",
                "min": 0,
                "step": 1000,
                "value": "{{_local.form?.extra_data?.price ?? ''}}",
                "placeholder": "예: 89000",
                "className": "input w-full"
              },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": {
                    "target": "local",
                    "form": { "extra_data": { "price": "{{Number($event.target.value) || 0}}" } },
                    "hasChanges": true
                  } }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "name": "Div",
          "children": [
            {
              "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["라이센스"]
            },
            {
              "type": "basic", "name": "Input",
              "props": {
                "type": "text",
                "value": "{{_local.form?.extra_data?.license ?? ''}}",
                "placeholder": "예: 1도메인 / 자사용",
                "className": "input w-full"
              },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local", "form": { "extra_data": { "license": "{{$event.target.value}}" } }, "hasChanges": true } }
              ]
            }
          ]
        },
        {
          "type": "basic", "name": "Div",
          "children": [
            { "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["데모 URL"] },
            { "type": "basic", "name": "Input",
              "props": { "type": "url",
                "value": "{{_local.form?.extra_data?.demo_url ?? ''}}",
                "placeholder": "https://...",
                "className": "input w-full" },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local", "form": { "extra_data": { "demo_url": "{{$event.target.value}}" } }, "hasChanges": true } }
              ] }
          ]
        },
        {
          "type": "basic", "name": "Div",
          "children": [
            { "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["구매 URL"] },
            { "type": "basic", "name": "Input",
              "props": { "type": "url",
                "value": "{{_local.form?.extra_data?.purchase_url ?? ''}}",
                "placeholder": "https://...",
                "className": "input w-full" },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local", "form": { "extra_data": { "purchase_url": "{{$event.target.value}}" } }, "hasChanges": true } }
              ] }
          ]
        },
        {
          "type": "basic", "name": "Div",
          "children": [
            { "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["최소 요구"] },
            { "type": "basic", "name": "Input",
              "props": { "type": "text",
                "value": "{{_local.form?.extra_data?.min_requirement ?? ''}}",
                "placeholder": "예: 그누보드 2.2.6.1+",
                "className": "input w-full" },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local", "form": { "extra_data": { "min_requirement": "{{$event.target.value}}" } }, "hasChanges": true } }
              ] }
          ]
        },
        {
          "type": "basic", "name": "Div",
          "children": [
            { "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["마지막 업데이트 (YYYY-MM-DD)"] },
            { "type": "basic", "name": "Input",
              "props": { "type": "text",
                "value": "{{_local.form?.extra_data?.last_update ?? ''}}",
                "placeholder": "2026-05-18",
                "className": "input w-full" },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local", "form": { "extra_data": { "last_update": "{{$event.target.value}}" } }, "hasChanges": true } }
              ] }
          ]
        },
        {
          "type": "basic", "name": "Div",
          "children": [
            { "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["다운로드 횟수"] },
            { "type": "basic", "name": "Input",
              "props": { "type": "number", "min": 0,
                "value": "{{_local.form?.extra_data?.download_count ?? ''}}",
                "placeholder": "0",
                "className": "input w-full" },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local", "form": { "extra_data": { "download_count": "{{Number($event.target.value) || 0}}" } }, "hasChanges": true } }
              ] }
          ]
        },
        {
          "type": "basic", "name": "Div",
          "children": [
            { "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["평점 (0~5)"] },
            { "type": "basic", "name": "Input",
              "props": { "type": "number", "min": 0, "max": 5, "step": 0.1,
                "value": "{{_local.form?.extra_data?.rating ?? ''}}",
                "placeholder": "5.0",
                "className": "input w-full" },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local", "form": { "extra_data": { "rating": "{{Number($event.target.value) || 0}}" } }, "hasChanges": true } }
              ] }
          ]
        },
        {
          "type": "basic", "name": "Div",
          "children": [
            { "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["리뷰 수"] },
            { "type": "basic", "name": "Input",
              "props": { "type": "number", "min": 0,
                "value": "{{_local.form?.extra_data?.review_count ?? ''}}",
                "placeholder": "0",
                "className": "input w-full" },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local", "form": { "extra_data": { "review_count": "{{Number($event.target.value) || 0}}" } }, "hasChanges": true } }
              ] }
          ]
        },
        {
          "type": "basic", "name": "Div",
          "props": { "className": "md:col-span-2" },
          "children": [
            { "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["한 줄 설명 (카드 + 상세 상단 표시)"] },
            { "type": "basic", "name": "Input",
              "props": { "type": "text",
                "value": "{{_local.form?.extra_data?.description_short ?? ''}}",
                "placeholder": "예: 스타트업·중소기업을 위한 클린한 비즈니스 테마",
                "className": "input w-full" },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local", "form": { "extra_data": { "description_short": "{{$event.target.value}}" } }, "hasChanges": true } }
              ] }
          ]
        },
        {
          "type": "basic", "name": "Div",
          "props": { "className": "md:col-span-2" },
          "children": [
            { "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["상세 설명 (긴 본문)"] },
            { "type": "basic", "name": "Textarea",
              "props": {
                "value": "{{_local.form?.extra_data?.description_long ?? ''}}",
                "placeholder": "여러 단락 입력 가능. 빈 줄로 단락 구분, <br> 줄바꿈 허용.",
                "rows": 6,
                "className": "input w-full" },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local", "form": { "extra_data": { "description_long": "{{$event.target.value}}" } }, "hasChanges": true } }
              ] }
          ]
        },
        {
          "type": "basic", "name": "Div",
          "props": { "className": "md:col-span-2" },
          "children": [
            { "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["설치 안내"] },
            { "type": "basic", "name": "Textarea",
              "props": {
                "value": "{{_local.form?.extra_data?.install_note ?? ''}}",
                "placeholder": "압축을 해제한 후 ...",
                "rows": 3,
                "className": "input w-full" },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local", "form": { "extra_data": { "install_note": "{{$event.target.value}}" } }, "hasChanges": true } }
              ] }
          ]
        }
      ]
    },

    {
      "type": "basic", "name": "Div",
      "props": { "className": "border-t border-gray-200 dark:border-gray-700 pt-6 space-y-6" },
      "children": [
        {
          "type": "basic", "name": "Div",
          "children": [
            { "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["포함 구성 (features) — JSON 문자열 배열"] },
            { "type": "basic", "name": "Textarea",
              "props": {
                "value": "{{JSON.stringify(_local.form?.extra_data?.features ?? [], null, 2)}}",
                "placeholder": "[\n  \"메인 페이지 1종\",\n  \"회사 소개 페이지\"\n]",
                "rows": 5,
                "className": "input w-full font-mono text-xs" },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local",
                    "form": { "extra_data": { "features": "{{(() => { try { return JSON.parse($event.target.value); } catch(e) { return _local.form?.extra_data?.features ?? []; } })()}}" } },
                    "hasChanges": true } }
              ] }
          ]
        },
        {
          "type": "basic", "name": "Div",
          "children": [
            { "type": "basic", "name": "Label",
              "props": { "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" },
              "children": ["업데이트 히스토리 (changelog) — JSON [{version, date, changes:[]}]"] },
            { "type": "basic", "name": "Textarea",
              "props": {
                "value": "{{JSON.stringify(_local.form?.extra_data?.changelog ?? [], null, 2)}}",
                "placeholder": "[\n  {\n    \"version\": \"v1.0.0\",\n    \"date\": \"2026-05-18\",\n    \"changes\": [\"최초 릴리스\"]\n  }\n]",
                "rows": 8,
                "className": "input w-full font-mono text-xs" },
              "actions": [
                { "event": "onChange", "type": "change", "handler": "setState",
                  "params": { "target": "local",
                    "form": { "extra_data": { "changelog": "{{(() => { try { return JSON.parse($event.target.value); } catch(e) { return _local.form?.extra_data?.changelog ?? []; } })()}}" } },
                    "hasChanges": true } }
              ] }
          ]
        }
      ]
    }
  ]
}
