{
  "version": "1.0.0",
  "layout_name": "contact/index",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "seo": {
      "enabled": true,
      "page_type": "default",
      "vars": { "site_name": "$core_settings:general.site_name" }
    }
  },
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "global",
        "aictAssetBase": "/api/templates/assets/ryan-offset/assets/images/aict",
        "hideDefaultHeader": true,
        "hideDefaultFooter": true
      }
    }
  ],
  "data_sources": [
    {
      "id": "myQuestions",
      "type": "api",
      "endpoint": "/api/plugins/offset-support/my-questions",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "fallback": { "data": [] }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": { "className": "aict-home" },
        "children": [
          { "partial": "partials/theme-aict/_subpage_header.json" },
          {
            "type": "composite",
            "name": "RevealScrollManager",
            "props": {}
          },
          {
            "type": "composite",
            "name": "PageHeader",
            "props": { "title": "문의" }
          },
          {
            "type": "composite",
            "name": "ContactSection",
            "props": {
              "loggedIn": "{{!!_global.currentUser?.uuid}}",
              "questions": "{{myQuestions.data ?? []}}",
              "writeHref": "/board/qna/write",
              "loginHref": "/login",
              "inquiryHref": "/inquiry"
            }
          },
          { "partial": "partials/home-aict/_aict_footer.json" }
        ]
      }
    ]
  }
}
