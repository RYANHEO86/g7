{
  "version": "1.0.1",
  "layout_name": "board/themes_index",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "seo": {
      "enabled": true,
      "data_sources": [
        "posts"
      ],
      "page_type": "board",
      "vars": {
        "site_name": "$core_settings:general.site_name",
        "board_name": "{{posts.data.board.name ?? '테마'}}"
      },
      "priority": 0.7,
      "changefreq": "daily",
      "og": {
        "type": "website"
      },
      "structured_data": {
        "@type": "ItemList"
      }
    }
  },
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "global",
        "aictAssetBase": "/api/templates/assets/ryan-offset/assets/images/aict",
        "hideDefaultHeader": true,
        "hideDefaultFooter": true
      }
    }
  ],
  "data_sources": [
    {
      "id": "posts",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/theme/posts",
      "method": "GET",
      "params": {
        "page": "{{query.page ?? 1}}",
        "per_page": 48,
        "search": "{{query.search ?? ''}}",
        "category": "{{query.category ?? ''}}"
      },
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "fallback": {
        "data": {
          "data": [],
          "board": {
            "categories": []
          },
          "pagination": {}
        }
      }
    },
    {
      "id": "themeMetas",
      "type": "api",
      "endpoint": "/api/plugins/offset-theme_catalog/theme/metas",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "loading_strategy": "progressive",
      "fallback": {
        "data": []
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "aict-home"
        },
        "children": [
          {
            "partial": "partials/theme-aict/_subpage_header.json"
          },
          {
            "type": "composite",
            "name": "PageHeader",
            "props": { "title": "테마" }
          },
          {
            "type": "composite",
            "name": "ThemeListSection",
            "props": {
              "categories": "{{[{key:'all', label:'전체'}].concat(((posts.data.board.categories ?? []).map(c => ({key: c, label: c}))))}}",
              "posts": "{{(posts.data.data ?? []).map(p => ({id: p.id, title: p.title, summary: ((themeMetas.data ?? []).find(x => x.post_id === p.id)?.description_short ?? ''), thumbnail: (p.thumbnail ?? ''), category: (p.category ?? ''), price: ((themeMetas.data ?? []).find(x => x.post_id === p.id)?.price ?? 0), href: '/board/theme/' + p.id}))}}",
              "perPage": 12,
              "baseHref": "/board/theme"
            }
          },
          {
            "partial": "partials/home-aict/_aict_footer.json"
          }
        ]
      }
    ]
  }
}