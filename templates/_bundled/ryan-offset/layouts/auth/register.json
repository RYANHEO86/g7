{
  "version": "1.0.0",
  "layout_name": "auth/register",
  "extends": "_user_base",
  "data_sources": [
    {
      "id": "termsContent",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-page/pages/terms",
      "method": "GET",
      "auto_fetch": false,
      "auth_mode": "optional"
    },
    {
      "id": "privacyContent",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-page/pages/privacy",
      "method": "GET",
      "auto_fetch": false,
      "auth_mode": "optional"
    }
  ],
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "global",
        "aictAssetBase": "/api/templates/assets/ryan-offset/assets/images/aict",
        "hideDefaultHeader": true,
        "hideDefaultFooter": true
      }
    },
    {
      "handler": "setState",
      "params": {
        "target": "local",
        "isRegistering": false,
        "registerError": null,
        "errors": null,
        "registerForm": {}
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": { "className": "aict-home" },
        "children": [
          { "partial": "partials/theme-aict/_subpage_header.json" },
          {
            "type": "basic",
            "name": "Section",
            "props": { "className": "auth-section" },
            "children": [
              {
                "type": "layout",
                "name": "Flex",
                "blur_until_loaded": "{{_global?.currentUser?.uuid}}",
                "props": { "justify": "center", "align": "start" },
                "children": [
                  { "partial": "partials/auth/_redirect_if_logged_in.json" },
                  {
                    "comment": "회원가입 카드",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "auth-card" },
                    "children": [
                      { "partial": "partials/auth/_register_form.json" },
                      {
                        "comment": "하단 링크 (이미 회원이신가요? 로그인)",
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "auth-foot" },
                        "children": [
                          { "type": "basic", "name": "Span", "text": "$t:auth.already_member" },
                          { "type": "basic", "name": "Span", "text": " " },
                          {
                            "type": "basic",
                            "name": "Button",
                            "props": { "type": "button", "className": "auth-link auth-link--accent" },
                            "actions": [
                              { "type": "click", "handler": "navigate", "params": { "path": "/login" } }
                            ],
                            "text": "$t:auth.login"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          { "partial": "partials/home-aict/_aict_footer.json" }
        ]
      }
    ]
  },
  "modals": [
    { "partial": "partials/auth/_modal_terms.json" },
    { "partial": "partials/auth/_modal_privacy.json" }
  ]
}
