{
  "version": "2.0.0",
  "layout_name": "home",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "seo": {
      "enabled": true,
      "data_sources": [],
      "priority": 1.0,
      "changefreq": "daily",
      "og": {
        "type": "website"
      },
      "structured_data": {
        "@type": "WebSite",
        "name": "{{_global.site_name ?? ''}}",
        "url": "{{_global.site_url ?? ''}}"
      }
    }
  },
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "global",
        "aictAssetBase": "/api/templates/assets/ryan-offset/assets/images/aict",
        "hideDefaultHeader": true,
        "hideDefaultFooter": true
      }
    }
  ],
  "data_sources": [],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "aict-home"
        },
        "children": [
          {
            "partial": "partials/home-aict/_overlay_header.json"
          },
          {
            "type": "composite",
            "name": "RevealScrollManager",
            "props": {}
          },
          {
            "partial": "partials/home-aict/_hero.json"
          },
          {
            "partial": "partials/home-aict/_section_themes.json"
          },
          {
            "partial": "partials/home-aict/_section_notice.json"
          },
          {
            "partial": "partials/home-aict/_section_research.json"
          },
          {
            "partial": "partials/home-aict/_section_glance.json"
          },
          {
            "partial": "partials/home-aict/_section_sns.json"
          },
          {
            "partial": "partials/home-aict/_aict_footer.json"
          }
        ]
      }
    ]
  }
}