{
  "meta": {
    "is_partial": true,
    "description": "공지(notice) 작성/수정 폼. _qna_form.json 기반 — 공개 공지용이라 비밀글/비회원 필드 없음. route.id 유무로 작성(POST)/수정(PUT) 통합. .qna-form__* 스타일 재사용. 공용 폼(_post_form) 변경 시 수동 동기화."
  },
  "type": "basic",
  "name": "Form",
  "props": {
    "id": "form",
    "className": "qna-form {{!form_meta?.data || !form_data?.data ? 'space-y-6 opacity-50 pointer-events-none' : 'space-y-6'}}"
  },
  "children": [
    {
      "comment": "상단 안내 박스",
      "type": "basic",
      "name": "Div",
      "props": { "className": "qna-form__intro" },
      "children": [
        {
          "type": "basic",
          "name": "Icon",
          "props": { "name": "bullhorn", "size": "sm", "className": "qna-form__intro-icon" }
        },
        {
          "type": "basic",
          "name": "Div",
          "props": { "className": "qna-form__intro-body" },
          "children": [
            {
              "type": "basic",
              "name": "P",
              "props": { "className": "qna-form__intro-title" },
              "text": "작성한 공지는 메인 알림장과 공지 목록에 바로 노출됩니다."
            },
            {
              "type": "basic",
              "name": "P",
              "props": { "className": "qna-form__intro-desc" },
              "text": "카테고리에 따라 알림장 탭(공지사항·업데이트·이벤트)으로 분류돼요."
            }
          ]
        }
      ]
    },
    {
      "comment": "전체 에러 메시지 박스",
      "type": "basic",
      "name": "Div",
      "if": "{{_local.errors && (typeof _local.errors === 'string' || Object.keys(_local.errors).length > 0)}}",
      "props": {
        "className": "bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-6"
      },
      "children": [
        {
          "type": "basic",
          "name": "Div",
          "props": { "className": "flex items-start gap-3" },
          "children": [
            {
              "type": "basic",
              "name": "Icon",
              "props": {
                "name": "triangle-exclamation",
                "className": "text-red-600 dark:text-red-400 mt-0.5",
                "size": "lg"
              }
            },
            {
              "type": "basic",
              "name": "Div",
              "props": { "className": "flex-1" },
              "children": [
                {
                  "type": "basic",
                  "name": "H3",
                  "props": { "className": "text-sm font-semibold text-red-800 dark:text-red-200 mb-2" },
                  "text": "$t:common.validation_errors"
                },
                {
                  "type": "basic",
                  "name": "Ul",
                  "props": { "className": "list-disc list-inside space-y-1 text-sm text-red-700 dark:text-red-300" },
                  "iteration": {
                    "source": "typeof _local.errors === 'string' ? [_local.errors] : Object.entries(_local.errors ?? {}).flatMap(([field, messages]) => Array.isArray(messages) ? messages : [messages])",
                    "item_var": "message"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Li",
                      "props": { "className": "text-sm text-red-700 dark:text-red-300" },
                      "text": "{{message}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "comment": "카테고리 칩",
      "type": "basic",
      "name": "Div",
      "if": "{{form_meta?.data?.board?.categories?.length > 0}}",
      "props": { "className": "qna-form__field" },
      "children": [
        {
          "type": "basic",
          "name": "Label",
          "props": { "className": "qna-form__label" },
          "children": [
            { "type": "basic", "name": "Span", "text": "카테고리" },
            { "type": "basic", "name": "Span", "props": { "className": "qna-form__req" }, "text": "*" }
          ]
        },
        {
          "type": "basic",
          "name": "Div",
          "props": { "className": "qna-form__chips" },
          "children": [
            {
              "type": "basic",
              "name": "Button",
              "iteration": {
                "source": "form_meta?.data?.board?.categories ?? []",
                "item_var": "cat"
              },
              "props": {
                "type": "button",
                "className": "qna-form__chip {{_local.form?.category === cat ? 'is-active' : ''}}"
              },
              "actions": [
                {
                  "type": "click",
                  "handler": "setState",
                  "params": {
                    "target": "local",
                    "form": { "category": "{{cat}}" },
                    "hasChanges": true
                  }
                }
              ],
              "text": "{{cat}}"
            }
          ]
        }
      ]
    },
    {
      "comment": "제목 입력",
      "type": "basic",
      "name": "Div",
      "props": { "className": "qna-form__field" },
      "children": [
        {
          "type": "basic",
          "name": "Label",
          "props": { "className": "qna-form__label" },
          "children": [
            { "type": "basic", "name": "Span", "text": "제목" },
            { "type": "basic", "name": "Span", "props": { "className": "qna-form__req" }, "text": "*" }
          ]
        },
        {
          "type": "basic",
          "name": "Input",
          "props": {
            "type": "text",
            "name": "title",
            "placeholder": "공지 제목을 입력하세요",
            "className": "qna-form__input {{_local.errors?.title ? 'is-error' : ''}}"
          }
        },
        {
          "type": "basic",
          "name": "P",
          "if": "{{_local.errors?.title}}",
          "props": { "className": "qna-form__error" },
          "text": "{{_local.errors?.title?.[0] ?? _local.errors?.title}}"
        }
      ]
    },
    {
      "comment": "내용 에디터",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "qna-form__field {{_local.errors?.content ? '[&_textarea]:!border-red-500 [&_textarea]:dark:!border-red-500 [&_textarea]:focus:!ring-red-500' : ''}}"
      },
      "children": [
        {
          "id": "content_section",
          "type": "extension_point",
          "name": "html_editor",
          "props": {
            "name": "content",
            "content": "{{_local.form?.content ?? ''}}",
            "isHtml": "{{(_local.form?.content_mode ?? 'text') === 'html'}}",
            "rows": 14,
            "placeholder": "공지 내용을 입력하세요. 줄바꿈과 서식을 사용할 수 있어요.",
            "label": "내용",
            "showHtmlModeToggle": true
          },
          "default": [
            {
              "type": "composite",
              "name": "HtmlEditor",
              "props": {
                "name": "content",
                "content": "{{_local.form?.content ?? ''}}",
                "isHtml": "{{(_local.form?.content_mode ?? 'text') === 'html'}}",
                "rows": 14,
                "placeholder": "공지 내용을 입력하세요. 줄바꿈과 서식을 사용할 수 있어요.",
                "label": "내용",
                "showHtmlModeToggle": true
              },
              "actions": [
                {
                  "event": "onIsHtmlChange",
                  "type": "change",
                  "handler": "setState",
                  "params": {
                    "target": "local",
                    "form": {
                      "content_mode": "{{$args[0].target.checked ? 'html' : 'text'}}"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "name": "P",
          "if": "{{_local.errors?.content}}",
          "props": { "className": "qna-form__error" },
          "text": "{{_local.errors?.content?.[0] ?? _local.errors?.content}}"
        }
      ]
    },
    {
      "comment": "파일 첨부",
      "type": "basic",
      "name": "Div",
      "if": "{{form_meta?.data?.board?.use_file_upload === true && form_meta?.data?.board?.user_abilities?.can_upload}}",
      "props": { "className": "qna-form__field" },
      "children": [
        {
          "type": "basic",
          "name": "Label",
          "props": { "className": "qna-form__label" },
          "children": [
            { "type": "basic", "name": "Icon", "props": { "name": "paperclip", "size": "sm", "className": "inline mr-1" } },
            { "type": "basic", "name": "Span", "text": "첨부파일 (선택)" }
          ]
        },
        {
          "type": "basic",
          "name": "P",
          "props": { "className": "qna-form__hint" },
          "text": "이미지나 PDF를 함께 올릴 수 있어요."
        },
        {
          "type": "composite",
          "name": "FileUploader",
          "props": {
            "collection": "post_attachments",
            "maxFiles": "{{form_meta?.data?.board?.max_file_count ?? 3}}",
            "maxSize": "{{form_meta?.data?.board?.max_file_size ?? 5}}",
            "accept": "{{form_meta?.data?.board?.allowed_extensions ? '.' + form_meta?.data?.board?.allowed_extensions?.join(',.') : '.jpg,.jpeg,.png,.pdf'}}",
            "initialFiles": "{{form_meta?.data?.attachments ?? []}}",
            "autoUpload": false,
            "uploadTriggerEvent": "upload:board_attachments",
            "compact": true,
            "confirmBeforeRemove": true,
            "confirmRemoveTitle": "$t:board.posts.form.confirm_remove_attachment_title",
            "confirmRemoveMessage": "$t:board.posts.form.confirm_remove_attachment_message",
            "uploadParams": {
              "temp_key": "{{_local.tempKey}}"
            },
            "apiEndpoints": {
              "upload": "/api/modules/sirsoft-board/boards/notice/attachments",
              "delete": "/api/modules/sirsoft-board/boards/notice/attachments/:id",
              "reorder": "/api/modules/sirsoft-board/boards/notice/attachments/reorder"
            }
          },
          "actions": [
            {
              "event": "onFilesChange",
              "type": "change",
              "handler": "setState",
              "if": "{{!_local.hasChanges}}",
              "params": { "target": "local", "hasChanges": true }
            },
            {
              "event": "onUploadError",
              "type": "change",
              "handler": "sequence",
              "actions": [
                {
                  "handler": "setState",
                  "params": { "target": "local", "uploadError": "{{$args[0]}}", "isSaving": false }
                },
                {
                  "handler": "toast",
                  "params": { "type": "error", "message": "{{$args[0]}}", "icon": "triangle-exclamation" }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "comment": "버튼 영역 (취소 / 등록·수정)",
      "type": "basic",
      "name": "Div",
      "props": { "className": "qna-form__actions" },
      "children": [
        {
          "type": "basic",
          "name": "Button",
          "props": { "type": "button", "className": "qna-form__btn qna-form__btn--ghost" },
          "actions": [
            { "type": "click", "handler": "navigate", "params": { "path": "/board/notice" } }
          ],
          "text": "취소"
        },
        {
          "type": "basic",
          "name": "Button",
          "props": {
            "type": "button",
            "disabled": "{{_local?.isSaving}}",
            "className": "qna-form__btn qna-form__btn--primary"
          },
          "actions": [
            {
              "type": "click",
              "handler": "sequence",
              "actions": [
                {
                  "handler": "setState",
                  "params": { "target": "local", "isSaving": true, "errors": null }
                },
                {
                  "handler": "emitEvent",
                  "params": { "event": "upload:board_attachments" }
                },
                {
                  "handler": "apiCall",
                  "target": "/api/modules/sirsoft-board/boards/notice/posts{{route.id ? '/' + route.id : ''}}",
                  "auth_required": true,
                  "params": {
                    "method": "{{route.id ? 'PUT' : 'POST'}}",
                    "body": "{{Object.assign({}, _local.form, { temp_key: _local?.tempKey })}}"
                  },
                  "onSuccess": [
                    {
                      "handler": "setState",
                      "params": { "target": "local", "isSaving": false, "hasChanges": false, "errors": null }
                    },
                    {
                      "handler": "toast",
                      "params": {
                        "type": "success",
                        "message": "{{route.id ? '공지가 수정되었습니다.' : '공지가 등록되었습니다.'}}"
                      }
                    },
                    {
                      "handler": "navigate",
                      "params": { "path": "/board/notice/{{route.id ? route.id : result?.data?.id}}" }
                    }
                  ],
                  "onError": [
                    {
                      "handler": "setState",
                      "params": { "target": "local", "isSaving": false, "errors": "{{error?.errors ?? null}}" }
                    },
                    {
                      "handler": "toast",
                      "params": { "type": "error", "message": "{{error?.message ?? '$t:common.error_occurred'}}" }
                    }
                  ]
                }
              ]
            }
          ],
          "children": [
            {
              "type": "basic",
              "name": "Icon",
              "if": "{{_local?.isSaving}}",
              "props": { "name": "spinner", "size": "sm", "className": "animate-spin" }
            },
            {
              "type": "basic",
              "name": "Span",
              "text": "{{_local?.isSaving ? '저장 중...' : (route.id ? '공지 수정' : '공지 등록')}}"
            }
          ]
        }
      ]
    }
  ]
}
