{
  "meta": {
    "is_partial": true,
    "description": "1:1 문의(qna) 전용 작성 폼. 안내박스/카테고리 칩은 전용 UI, 에러박스·제목·내용·첨부·제출 액션은 _post_form.json 복사본이라 공용 폼 변경 시 수동 동기화 필요. 공지사항/비밀글 토글/비회원 필드는 제거(비밀글은 서버 secret_mode=always 강제)."
  },
  "type": "basic",
  "name": "Form",
  "props": {
    "id": "form",
    "className": "qna-form {{!form_meta?.data || !form_data?.data ? 'space-y-6 opacity-50 pointer-events-none' : 'space-y-6'}}"
  },
  "children": [
    {
      "comment": "상단 안내 박스 (신뢰·기대치 관리)",
      "type": "basic",
      "name": "Div",
      "props": { "className": "qna-form__intro" },
      "children": [
        {
          "type": "basic",
          "name": "Icon",
          "props": { "name": "lock", "size": "sm", "className": "qna-form__intro-icon" }
        },
        {
          "type": "basic",
          "name": "Div",
          "props": { "className": "qna-form__intro-body" },
          "children": [
            {
              "type": "basic",
              "name": "P",
              "props": { "className": "qna-form__intro-title" },
              "text": "남겨주시면 담당자가 확인 후 답변드려요."
            },
            {
              "type": "basic",
              "name": "P",
              "props": { "className": "qna-form__intro-desc" },
              "text": "작성하신 문의는 본인과 관리자만 볼 수 있어요."
            }
          ]
        }
      ]
    },
    {
      "comment": "전체 에러 메시지 박스 (source: _post_form.json 13-79)",
      "type": "basic",
      "name": "Div",
      "if": "{{_local.errors && (typeof _local.errors === 'string' || Object.keys(_local.errors).length > 0)}}",
      "props": {
        "className": "bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-6"
      },
      "children": [
        {
          "type": "basic",
          "name": "Div",
          "props": { "className": "flex items-start gap-3" },
          "children": [
            {
              "type": "basic",
              "name": "Icon",
              "props": {
                "name": "triangle-exclamation",
                "className": "text-red-600 dark:text-red-400 mt-0.5",
                "size": "lg"
              }
            },
            {
              "type": "basic",
              "name": "Div",
              "props": { "className": "flex-1" },
              "children": [
                {
                  "type": "basic",
                  "name": "H3",
                  "props": {
                    "className": "text-sm font-semibold text-red-800 dark:text-red-200 mb-2"
                  },
                  "text": "$t:common.validation_errors"
                },
                {
                  "type": "basic",
                  "name": "Ul",
                  "props": {
                    "className": "list-disc list-inside space-y-1 text-sm text-red-700 dark:text-red-300"
                  },
                  "iteration": {
                    "source": "typeof _local.errors === 'string' ? [_local.errors] : Object.entries(_local.errors ?? {}).flatMap(([field, messages]) => Array.isArray(messages) ? messages : [messages])",
                    "item_var": "message"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Li",
                      "props": {
                        "className": "text-sm text-red-700 dark:text-red-300"
                      },
                      "text": "{{message}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "comment": "카테고리 칩 (board.categories 문자열 배열)",
      "type": "basic",
      "name": "Div",
      "if": "{{form_meta?.data?.board?.categories?.length > 0}}",
      "props": { "className": "qna-form__field" },
      "children": [
        {
          "type": "basic",
          "name": "Label",
          "props": { "className": "qna-form__label" },
          "text": "어떤 점이 궁금하세요?"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": { "className": "qna-form__chips" },
          "children": [
            {
              "type": "basic",
              "name": "Button",
              "iteration": {
                "source": "form_meta?.data?.board?.categories ?? []",
                "item_var": "cat"
              },
              "props": {
                "type": "button",
                "className": "qna-form__chip {{_local.form?.category === cat ? 'is-active' : ''}}"
              },
              "actions": [
                {
                  "type": "click",
                  "handler": "setState",
                  "params": {
                    "target": "local",
                    "form": { "category": "{{cat}}" },
                    "hasChanges": true
                  }
                }
              ],
              "text": "{{cat}}"
            }
          ]
        }
      ]
    },
    {
      "comment": "제목 입력 (source: _post_form.json 513-558)",
      "type": "basic",
      "name": "Div",
      "props": { "className": "qna-form__field" },
      "children": [
        {
          "type": "basic",
          "name": "Label",
          "props": { "className": "qna-form__label" },
          "children": [
            { "type": "basic", "name": "Span", "text": "제목" },
            {
              "type": "basic",
              "name": "Span",
              "props": { "className": "qna-form__req" },
              "text": "*"
            }
          ]
        },
        {
          "type": "basic",
          "name": "Input",
          "props": {
            "type": "text",
            "name": "title",
            "placeholder": "문의 제목을 적어주세요",
            "className": "qna-form__input {{_local.errors?.title ? 'is-error' : ''}}"
          }
        },
        {
          "type": "basic",
          "name": "P",
          "if": "{{_local.errors?.title}}",
          "props": { "className": "qna-form__error" },
          "text": "{{_local.errors?.title?.[0] ?? _local.errors?.title}}"
        }
      ]
    },
    {
      "comment": "내용 에디터 래퍼 (source: _post_form.json 560-622)",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "qna-form__field {{_local.errors?.content ? '[&_textarea]:!border-red-500 [&_textarea]:dark:!border-red-500 [&_textarea]:focus:!ring-red-500' : ''}}"
      },
      "children": [
        {
          "comment": "내용 에디터",
          "id": "content_section",
          "type": "extension_point",
          "name": "html_editor",
          "props": {
            "name": "content",
            "content": "{{_local.form?.content ?? ''}}",
            "isHtml": "{{(_local.form?.content_mode ?? 'text') === 'html'}}",
            "rows": 12,
            "placeholder": "문의 내용을 자세히 적어주실수록 정확히 답변드릴 수 있어요.",
            "label": "내용",
            "showHtmlModeToggle": true
          },
          "default": [
            {
              "type": "composite",
              "name": "HtmlEditor",
              "props": {
                "name": "content",
                "content": "{{_local.form?.content ?? ''}}",
                "isHtml": "{{(_local.form?.content_mode ?? 'text') === 'html'}}",
                "rows": 12,
                "placeholder": "문의 내용을 자세히 적어주실수록 정확히 답변드릴 수 있어요.",
                "label": "내용",
                "showHtmlModeToggle": true
              },
              "actions": [
                {
                  "event": "onIsHtmlChange",
                  "type": "change",
                  "handler": "setState",
                  "params": {
                    "target": "local",
                    "form": {
                      "content_mode": "{{$args[0].target.checked ? 'html' : 'text'}}"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "comment": "내용 필드 에러 메시지",
          "type": "basic",
          "name": "P",
          "if": "{{_local.errors?.content}}",
          "props": { "className": "qna-form__error" },
          "text": "{{_local.errors?.content?.[0] ?? _local.errors?.content}}"
        }
      ]
    },
    {
      "comment": "파일 첨부 (source: _post_form.json 623-721, route.slug fallback 유지)",
      "type": "basic",
      "name": "Div",
      "if": "{{form_meta?.data?.board?.use_file_upload === true && form_meta?.data?.board?.user_abilities?.can_upload}}",
      "props": { "className": "qna-form__field" },
      "children": [
        {
          "type": "basic",
          "name": "Label",
          "props": { "className": "qna-form__label" },
          "children": [
            {
              "type": "basic",
              "name": "Icon",
              "props": { "name": "paperclip", "size": "sm", "className": "inline mr-1" }
            },
            { "type": "basic", "name": "Span", "text": "첨부파일 (선택)" }
          ]
        },
        {
          "type": "basic",
          "name": "P",
          "props": { "className": "qna-form__hint" },
          "text": "스크린샷 등을 함께 올려주시면 더 빠르게 도와드릴 수 있어요."
        },
        {
          "type": "composite",
          "name": "FileUploader",
          "props": {
            "collection": "post_attachments",
            "maxFiles": "{{form_meta?.data?.board?.max_file_count ?? 5}}",
            "maxSize": "{{form_meta?.data?.board?.max_file_size ?? 10}}",
            "accept": "{{form_meta?.data?.board?.allowed_extensions ? '.' + form_meta?.data?.board?.allowed_extensions?.join(',.') : '.jpg,.jpeg,.png,.gif,.pdf,.zip'}}",
            "initialFiles": "{{form_meta?.data?.attachments ?? []}}",
            "autoUpload": false,
            "uploadTriggerEvent": "upload:board_attachments",
            "compact": true,
            "confirmBeforeRemove": true,
            "confirmRemoveTitle": "$t:board.posts.form.confirm_remove_attachment_title",
            "confirmRemoveMessage": "$t:board.posts.form.confirm_remove_attachment_message",
            "uploadParams": {
              "temp_key": "{{_local.tempKey}}"
            },
            "apiEndpoints": {
              "upload": "/api/modules/sirsoft-board/boards/{{route.slug ? route.slug : form_meta?.data?.board?.slug}}/attachments",
              "delete": "/api/modules/sirsoft-board/boards/{{route.slug ? route.slug : form_meta?.data?.board?.slug}}/attachments/:id",
              "reorder": "/api/modules/sirsoft-board/boards/{{route.slug ? route.slug : form_meta?.data?.board?.slug}}/attachments/reorder"
            }
          },
          "actions": [
            {
              "event": "onFilesChange",
              "type": "change",
              "handler": "setState",
              "if": "{{!_local.hasChanges}}",
              "params": {
                "target": "local",
                "hasChanges": true
              }
            },
            {
              "event": "onUploadError",
              "type": "change",
              "handler": "sequence",
              "actions": [
                {
                  "handler": "setState",
                  "params": {
                    "target": "local",
                    "uploadError": "{{$args[0]}}",
                    "isSaving": false
                  }
                },
                {
                  "handler": "toast",
                  "params": {
                    "type": "error",
                    "message": "{{$args[0]}}",
                    "icon": "triangle-exclamation"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "comment": "버튼 영역 (source: _post_form.json 722-848, 작성 전용)",
      "type": "basic",
      "name": "Div",
      "props": { "className": "qna-form__actions" },
      "children": [
        {
          "comment": "취소 → 문의 페이지로 복귀",
          "type": "basic",
          "name": "Button",
          "props": {
            "type": "button",
            "className": "qna-form__btn qna-form__btn--ghost"
          },
          "actions": [
            {
              "type": "click",
              "handler": "navigate",
              "params": { "path": "/contact" }
            }
          ],
          "text": "취소"
        },
        {
          "type": "basic",
          "name": "Button",
          "props": {
            "type": "button",
            "disabled": "{{_local?.isSaving}}",
            "className": "qna-form__btn qna-form__btn--primary"
          },
          "actions": [
            {
              "type": "click",
              "handler": "sequence",
              "actions": [
                {
                  "handler": "setState",
                  "params": {
                    "target": "local",
                    "isSaving": true,
                    "errors": null
                  }
                },
                {
                  "handler": "emitEvent",
                  "params": { "event": "upload:board_attachments" }
                },
                {
                  "handler": "apiCall",
                  "target": "/api/modules/sirsoft-board/boards/{{route.slug ? route.slug : form_meta?.data?.board?.slug}}/posts",
                  "auth_required": true,
                  "params": {
                    "method": "POST",
                    "body": "{{Object.assign({}, _local.form, { temp_key: _local?.tempKey })}}"
                  },
                  "onSuccess": [
                    {
                      "handler": "setState",
                      "params": {
                        "target": "local",
                        "isSaving": false,
                        "hasChanges": false,
                        "errors": null
                      }
                    },
                    {
                      "handler": "toast",
                      "params": {
                        "type": "success",
                        "message": "문의가 등록되었습니다."
                      }
                    },
                    {
                      "handler": "navigate",
                      "params": {
                        "path": "/board/{{route?.slug ? route?.slug : form_meta?.data?.board?.slug}}/{{result?.data?.id}}"
                      }
                    }
                  ],
                  "onError": [
                    {
                      "handler": "setState",
                      "params": {
                        "target": "local",
                        "isSaving": false,
                        "errors": "{{error?.errors ?? null}}"
                      }
                    },
                    {
                      "handler": "toast",
                      "params": {
                        "type": "error",
                        "message": "{{error?.message ?? '$t:common.error_occurred'}}"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "children": [
            {
              "type": "basic",
              "name": "Icon",
              "if": "{{_local?.isSaving}}",
              "props": {
                "name": "spinner",
                "size": "sm",
                "className": "animate-spin"
              }
            },
            {
              "type": "basic",
              "name": "Span",
              "text": "{{_local?.isSaving ? '등록 중...' : '문의 등록'}}"
            }
          ]
        }
      ]
    }
  ]
}
