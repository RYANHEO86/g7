{
    "identifier": "ryan-offset",
    "vendor": "ryan",
    "name": {
        "ko": "Offset",
        "en": "Offset"
    },
    "version": "1.0.0",
    "license": "MIT",
    "description": {
        "ko": "오프셋 사용자 템플릿 (sirsoft-basic 기반 커스텀)",
        "en": "Offset user template (customized from sirsoft-basic)"
    },
    "type": "user",
    "locales": ["ko", "en"],
    "author": {
        "name": "ryan",
        "email": "ryan@ryanlab.kr"
    },
    "release_date": "2026-05-28",
    "g7_version": ">=7.0.0-beta.4",
    "dependencies": {
        "modules": {
            "sirsoft-board": ">=1.0.0-beta.4",
            "sirsoft-ecommerce": ">=1.0.0-beta.3",
            "sirsoft-page": ">=1.0.0-beta.3"
        },
        "plugins": {
            "sirsoft-daum_postcode": ">=1.0.0-beta.2"
        }
    },
    "assets": {
        "css": ["dist/css/components.css"],
        "js": ["dist/js/components.iife.js"],
        "fonts": [],
        "images": []
    },
    "components": {
        "basic": [
            "a", "button", "checkbox", "div", "form",
            "h1", "h2", "h3", "h4", "hr", "icon", "img", "input",
            "label", "li", "nav", "p", "section",
            "select", "span", "svg", "table", "tbody",
            "td", "textarea", "th", "thead", "tr", "ul"
        ],
        "composite": [
            "header", "footer", "mobile-nav",
            "product-card", "rich-text-editor", "image-gallery",
            "quantity-selector", "post-reactions", "social-login-buttons",
            "file-uploader", "card", "modal", "toast", "pagination",
            "stat-card", "status-badge", "tab-navigation", "empty-state",
            "loading-spinner", "breadcrumb", "search-bar", "dropdown"
        ],
        "layout": [
            "container", "flex", "grid", "section"
        ]
    },
    "preview": {
        "thumbnail": "preview/thumbnail.png",
        "screenshots": [
            "preview/screenshot1.png",
            "preview/screenshot2.png"
        ]
    },
    "error_config": {
        "layouts": {
            "401": "401",
            "404": "404",
            "403": "403",
            "500": "500",
            "503": "503",
            "maintenance": "maintenance"
        }
    },
    "features": {
        "dark_mode": false,
        "responsive": true,
        "multi_language": true,
        "multi_currency": true
    },
    "github_url": "https://github.com/gnuboard/g7-template-ryan-offset",
    "github_changelog_url": "https://github.com/gnuboard/g7-template-ryan-offset/blob/main/CHANGELOG.md"
}
